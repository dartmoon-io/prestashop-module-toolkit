{
    "name": "dartmoon/prestashop-module-toolkit",
    "description": "Module development components for PrestaShop 9.2 and later",
    "type": "library",
    "license": "MIT",
    "require": {"php": "^8.1"},
    "require-dev": {"phpunit/phpunit": "^10.5", "symfony/console": "^6.4"},
    "suggest": {"symfony/console": "Provided by PrestaShop; required to use Dartmoon\\Console\\AbstractCommand"},
    "replace": {
        "dartmoon/prestashop-config": "*",
        "dartmoon/prestashop-console": "*",
        "dartmoon/prestashop-hooks": "*",
        "dartmoon/prestashop-tabmanager": "*",
        "dartmoon/prestashop-utils": "*"
    },
    "autoload": {"psr-4": {"Dartmoon\\": "src/"}},
    "autoload-dev": {"psr-4": {"Dartmoon\\Tests\\": "tests/"}},
    "scripts": {"test": "phpunit"},
    "config": {"sort-packages": true, "platform": {"php": "8.1.0"}}
}
