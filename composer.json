{
    "name": "dartmoon/prestashop-module-toolkit",
    "description": "Module development components for PrestaShop 9.2",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpunit/phpunit": "^10.5",
        "prestashop/php-dev-tools": "^5.0",
        "symfony/console": "^6.4"
    },
    "suggest": {
        "ext-ftp": "Required for FTP downloads",
        "ext-gd": "Required for native PrestaShop image imports",
        "ext-iconv": "Enables ASCII transliteration in Slugify",
        "ext-mbstring": "Required for Unicode title filters and catalog import helpers",
        "symfony/console": "Provided by PrestaShop; required to use Dartmoon\\Console\\AbstractCommand"
    },
    "replace": {
        "dartmoon/prestashop-config": "*",
        "dartmoon/prestashop-console": "*",
        "dartmoon/prestashop-hooks": "*",
        "dartmoon/prestashop-tabmanager": "*",
        "dartmoon/prestashop-utils": "*"
    },
    "autoload": {
        "psr-4": {
            "Dartmoon\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dartmoon\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "quality": "@php vendor/bin/php-cs-fixer fix --dry-run --diff",
        "quality:fix": "@php vendor/bin/php-cs-fixer fix",
        "verify": [
            "@quality",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.1.0"
        }
    }
}
